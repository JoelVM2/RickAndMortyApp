@model List<RickAndMortyApp.Models.Character>

<h1>Rick & Morty Characters</h1>

<table border="1" cellpadding="6" style="border-collapse: collapse;">
    <tr>
        <th>Image</th>
        <th>Name</th>
        <th>Status</th>
        <th>Species</th>
    </tr>

    @foreach (var c in Model)
    {
        <tr>
            <td><img src="@c.Image" width="80" /></td>
            <td>@c.Name</td>
            <td>@c.Status</td>
            <td>@c.Species</td>
        </tr>
    }
</table>
