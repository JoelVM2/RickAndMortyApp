@model RickAndMortyApp.Models.CharacterListViewModel
<h1>Rick and Morty - Characters</h1>

<!-- Formulario para los filtros -->
<form method="get" asp-controller="Characters" asp-action="Index" class="mb-4">
    <label class="ms-3">Name:</label>
    <input type="text" name="name" value="@Model.Name" class="form-control" style="width:200px; display:inline-block;" />

    <label>Status:</label>
    <select name="status" class="form-select" style="width:200px; display:inline-block;">
        <option value="">-- All --</option>

        <option value="alive" selected="@(Model.Status == "alive")">Alive</option>
        <option value="dead" selected="@(Model.Status == "dead")">Dead</option>
        <option value="unknown" selected="@(Model.Status == "unknown")">Unknown</option>
    </select>

    <label>Species:</label>
    <select name="species" class="form-select" style="width:200px; display:inline-block;">
        <option value="">-- All --</option>

        <option value="human" selected="@(Model.Species == "human")">Human</option>
        <option value="humanoid" selected="@(Model.Species == "humanoid")">Humanoid</option>
        <option value="robot" selected="@(Model.Species == "robot")">Robot</option>
        <option value="cronenberg" selected="@(Model.Species == "cronenberg	")">Cronenberg	</option>
        <option value="Disease" selected="@(Model.Species == "disease	")">Disease	</option>
        <option value="alien" selected="@(Model.Species == "alien")">Alien</option>
        <option value="poopybutthole" selected="@(Model.Species == "poopybuthole")">Poopybutthole</option>
        <option value="mythological creature" selected="@(Model.Species == "mythological creature")">Mythological Creature</option>
        <option value="unknown" selected="@(Model.Species == "unknown")">Unknown</option>
    </select>

    <label>Gender:</label>
    <select name="gender" class="form-select" style="width:200px; display:inline-block;">
        <option value="">-- All --</option>

        <option value="male" selected="@(Model.Gender == "male")">Male</option>
        <option value="female" selected="@(Model.Gender == "female")">Female</option>
        <option value="unknown" selected="@(Model.Gender == "unknown")">Unknown</option>
    </select>

    <button type="submit" class="btn btn-primary ms-3">Filter</button>
</form>

<!-- Estructura de la tabla -->
<table class="table table-bordered">
    <thead>
        <tr>
            <th>Image</th>
            <th>Name</th>
            <th>Status</th>
            <th>Species</th>
            <th>Gender</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var c in Model.Characters)
        {
            <tr>
                <td><img src="@c.Image" width="80" /></td>
                <td>@c.Name</td>
                <td>@c.Status</td>
                <td>@c.Species</td>
                <td>@c.Gender</td>
            </tr>
        }
    </tbody>
</table>



<nav>
    <ul class="pagination">

        @if (Model.Page > 1)
        {
            <li class="page-item">
                <a class="page-link"
                   asp-action="Index"
                   asp-route-page="@(Model.Page - 1)"
                   asp-route-status="@Model.Status"
                   asp-route-name="@Model.Name">
                    Previous
                </a>
            </li>
        }
        
        <!-- Paginación con límite de 10 páginas visibles -->
        @{
            int maxPages = 10;
            int half = maxPages / 2;

            int start = Model.Page - half;
            if (start < 1) start = 1;

            int end = start + maxPages - 1;
            if (end > Model.TotalPages) end = Model.TotalPages;

            if (end - start < maxPages - 1)
            {
                start = Math.Max(1, end - maxPages + 1);
            }
        }

        @for (int i = start; i <= end; i++)
        {
            <li class="page-item @(i == Model.Page ? "active" : "")">
                <a class="page-link"
                   asp-action="Index"
                   asp-route-page="@i"
                   asp-route-status="@Model.Status"
                   asp-route-name="@Model.Name">
                    @i
                </a>
            </li>
        }

        @if (Model.Page < Model.TotalPages)
        {
            <li class="page-item">
                <a class="page-link"
                   asp-action="Index"
                   asp-route-page="@(Model.Page + 1)"
                   asp-route-status="@Model.Status"
                   asp-route-name="@Model.Name">
                    Next
                </a>
            </li>
        }

    </ul>
</nav>
